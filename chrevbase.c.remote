#include <linux/types.h>
#include <linux/kernel.h>
#include <linux/delay.h>
#include <linux/ide.h>
#include <linux/init.h>
#include <linux/module.h>

#define CHREVBASE_NAME "chrevbase"
#define CHREVBASE_MAJOR 200
static char kerbal[] = {"kerbal rad"};
static int chrevbase_release(struct inode *inode,struct file *filp){
	printk("chrevbase_release\n");
	return 0;

}
static int chrevbase_open(struct inode *inode, struct file *filp){
	printk("chrevbase_open\n");
	return 0;
}


#define KBUF_SIZE 1024
static char kbuf[KBUF_SIZE];

static ssize_t chrevbase_read(struct file *filp, char __user *buf,
                               size_t count, loff_t *off)
{
    /* 超过缓冲区范围直接返回0(EOF) */


    /* 核心：内核→用户空间拷贝 */
	memcpy(kbuf,kerbal,sizeof(kerbal));
	copy_to_user(buf, kbuf  count)

    return 0;
}

static ssize_t chrevbase_write(struct file *filp, const char __user *buf,
                                size_t count, loff_t *off)
{
    /* 写入长度不能超过剩余空间 */
    if (count > KBUF_SIZE - *off)
        count = KBUF_SIZE - *off;

    /* 核心：用户空间→内核拷贝 */
    if (copy_from_user(kbuf + *off, buf, count))
        return -EFAULT;

    *off += count;
    printk("chrdevbase_write: %s bytes\n", kbuf);
    return count;
}


static struct  file_operations chrevbase_fops=
{
	.owner = THIS_MODULE,	
	.open = chrevbase_open,
	.release = chrevbase_release,
	.read = chrevbase_read,
	.write = chrevbase_write,
};

static int __init chrevbase_init(void){
	int chrev_register=0;
	chrev_register=register_chrdev(CHREVBASE_MAJOR,CHREVBASE_NAME,&chrevbase_fops);
	if(chrev_register<0){
		printk("chrevbase register error\n");
		return -1;
	}
	else{
		printk("chrevbase register ok\n");
	}
	return 0;	
}

static int __exit chrevbase_exit(void){
	unregister_chrdev(CHREVBASE_MAJOR, CHREVBASE_NAME);
}



module_init(chrevbase_init);
module_exit(chrevbase_exit);


